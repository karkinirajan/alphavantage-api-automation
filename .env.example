# Copy to .env (never commit it) and fill in your own values. Every value below is a demo.

# --- Alpha Vantage ---
# Your key from https://www.alphavantage.co/support/#api-key . "demo" is the key used in Alpha Vantage's own
# documentation examples; it is not a real account. The free key allows 25 requests a day, so answers are cached.
ALPHAVANTAGE_API_KEY=demo

# --- Web app ---
# Signs the session cookie (at least 16 characters). It must stay the same between restarts:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Where users reach the app. https:// makes the session cookie Secure.
PUBLIC_URL=http://localhost:5004
DATABASE_URL=sqlite:///dashboard.db

# --- Optional ---
# Seconds to wait for Alpha Vantage
REQUEST_TIMEOUT=20
# How long an answer is kept before Alpha Vantage is asked again, in seconds
MARKET_STATUS_TTL=600
MOVERS_TTL=3600
DAILY_TTL=3600
# How long a rate-limit notice or an unknown-symbol answer is remembered
NOTICE_TTL=60
# Only for tests and local fakes
ALPHAVANTAGE_BASE_URL=
